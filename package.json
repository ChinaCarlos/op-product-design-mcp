{
  "name": "op-product-design-mcp",
  "version": "1.1.0",
  "type": "module",
  "description": "MCP server that generates Spark OP HTML prototypes with live preview and export",
  "author": "lazykids119 <lazykids520@gmail.com>",
  "license": "MIT",
  "bin": {
    "op-product-design-mcp": "dist/cli.js",
    "op-prototype-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "references",
    "styles",
    "templates",
    "examples",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChinaCarlos/op-product-design-mcp.git"
  },
  "homepage": "https://github.com/ChinaCarlos/op-product-design-mcp",
  "bugs": {
    "url": "https://github.com/ChinaCarlos/op-product-design-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cursor",
    "codex",
    "prototype",
    "antd",
    "agent"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsc --watch",
    "smoke": "tsc && node scripts/smoke.mjs",
    "smoke:multi": "tsc && node scripts/smoke-multi-process.mjs",
    "install-skill": "node dist/cli.js install",
    "publish:npm": "npm publish --access public --registry https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.21.0"
}
